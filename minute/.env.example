# LLM — local Ollama by default (open-source). Optional: MINUTE_LLM_BACKEND=anthropic|openai|proxy
MINUTE_LLM_BACKEND=ollama
MINUTE_LLM_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# GitHub — PAT with Contents: Read and write + Pull requests: Read and write on the playground repo
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Slack (Socket Mode — no public URL needed)
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
SLACK_SIGNING_SECRET=

# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_PUBLIC_KEY=
MINUTE_SIGNING_SECRET=

PORT=8787
MINUTE_PUBLIC_URL=
MINUTE_CONFIG=minute.config.yaml
MINUTE_DATA_DIR=.data
MINUTE_MAX_JOBS=2
MINUTE_JOB_TIMEOUT_MS=480000
LOG_LEVEL=info
NODE_ENV=development
